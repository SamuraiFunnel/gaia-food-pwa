{
  "version": 8,
  "name": "Gaia Food — Carta (guida turistica)",
  "metadata": {
    "gaia:notes": "Style MapLibre caldo/illustrato per Gaia Food. Tile vettoriali gratuite OpenFreeMap (schema OpenMapTiles). Palette editoriale: carta #F4F1EB, verde #16A34A, celeste #0EA5E9, terra #C2A07A/#8C6838, inchiostro #1F1812."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#F4F1EB" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#DDE8CE",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "park"],
      "paint": {
        "fill-color": "#E4ECD6",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "sand"],
      "paint": { "fill-color": "#F3E9D9" }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {
        "fill-color": "#EFE9DC",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#D7E6C6",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "park-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "line-color": "#16A34A",
        "line-opacity": 0.22,
        "line-width": 1
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "#CDE7F2" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#B6DCEC",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 1.8]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#E4D4BA",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 14, 8, 18, 22],
        "line-opacity": 0.9
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track", "path"],
      "minzoom": 12,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#EBDDC6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 18, 6]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#F6EFE2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 14, 5, 18, 16]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "minzoom": 12,
      "paint": {
        "line-color": "#D8C7AE",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 18, 1.6],
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#EAE0CF",
        "fill-outline-color": "#DDD0B9",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 15.5, 0.8]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": {
        "line-color": "#C2A07A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.8, 10, 1.8],
        "line-dasharray": [4, 3],
        "line-opacity": 0.5
      }
    },
    {
      "id": "boundary-region",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", [">", "admin_level", 2], ["<=", "admin_level", 4]],
      "minzoom": 6,
      "paint": {
        "line-color": "#C2A07A",
        "line-width": 0.7,
        "line-dasharray": [2, 3],
        "line-opacity": 0.35
      }
    },
    {
      "id": "place-water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 14, 13],
        "text-max-width": 6
      },
      "paint": {
        "text-color": "#0C7FB0",
        "text-halo-color": "#F4F1EB",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-other",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "village", "hamlet", "suburb", "neighbourhood"],
      "minzoom": 11,
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 15, 13],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#75695B",
        "text-halo-color": "#F4F1EB",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "town"],
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 15],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#564B41",
        "text-halo-color": "#F4F1EB",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city"],
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 12, 18],
        "text-max-width": 8,
        "text-transform": "none"
      },
      "paint": {
        "text-color": "#1F1812",
        "text-halo-color": "#F4F1EB",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "country"],
      "maxzoom": 8,
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 7, 16],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#8C6838",
        "text-halo-color": "#F4F1EB",
        "text-halo-width": 1.6
      }
    }
  ]
}
